    scene bg temple_night with slow_dissolve
    play ambience "audio/temple_tone.mp3" fadein 3.0 volume 0.2
    play music hazymoon fadein 2.5 volume 0.2
    pause 1.5
    show screen nvl_frame with Dissolve(0.8)
    pause 0.4
    nvl clear

    n2 "She found her where she expected. Above the maple, on the side wall, the lanterns lit below her."
    n2 "Naginata across her knees. Feet over the edge."
    n2 "The road beyond the gate was dark."

    show nvl_shina neutral at nvl_stage_left onlayer nvl_chars with dissolve
    n2 "Shina heard Makoto come up below her and did not look down."

    sh2 "Not following me, are you."

    show nvl_makoto neutral at nvl_stage_right onlayer nvl_chars with dissolve
    mk2 "That was the first thing you ever said to me."
    sh2 "Was it."
    mk2 "On the side steps. Your first night here."
    sh2 "Mm."
    sh2 "Good line. I use it."

    nvl clear

    $ duck(level=0.1, delay=0.3)
    n2 "Makoto stood at the base of the wall."
    n2 "No one was watching her. She did not arrange her hands. She did not check the carriage of her shoulders."
    n2 "She simply stood the way she stood when the body had no one to perform for."
    $ unduck(level=0.25, delay=2.0)

    nvl clear

    mk2 "You haven't answered."
    sh2 "Deadline's tomorrow."
    mk2 "Yes."
    sh2 "Plenty of time."

    n2 "She was looking at the road. The quality of attention that meant she was watching it, not just looking at it."

    $ duck(level=0.2, delay=0.4)
    mk2 "The position would formalize what you already do."
    sh2 "I know what it would do."
    mk2 "The oath is permanent."
    sh2 "I know what an oath is."
    $ unduck(level=0.3, delay=1.5)

    n2 "A pause. The kind that comes when both people in a conversation know what the conversation is actually about and are going around it carefully."

    show nvl_makoto amused at nvl_stage_right onlayer nvl_chars with dissolve
    mk2 "I'm not here to tell you what to decide."
    show nvl_shina neutral at nvl_stage_left onlayer nvl_chars with dissolve
    sh2 "Good."
    mk2 "I would just like you to have the full accounting."
    sh2 "Full accounting."
    mk2 "Of the relevant details."

    nvl clear

    n2 "Shina looked down at her for the first time."
    n2 "Makoto met her eyes."

    $ duck(level=0.1, delay=0.5)
    mk2 "If you go — I would miss you."
    $ unduck(level=0.2, delay=3.0)

    n2 "She said it the way she said things that were true and required no ornamentation."
    n2 "Without softening it into something more manageable."
    n2 "Just: the fact, placed down, available."

    show nvl_shina embarrassed at nvl_stage_left onlayer nvl_chars with dissolve
    n2 "Shina looked away."
    n2 "Back at the road. Back at the place where the lantern light ended and the dark began."

    nvl clear

    $ menu_owner = "shina"
    menu:
        "Shina doesn't answer right away."

        "She almost does. Then doesn't.":
            $ shina_stay_points += 1
            n2 "She opened her mouth."
            n2 "There was a sentence there — the plain one, the one that would have named it."
            n2 "She let it pass."
            sh2 "..."
            n2 "She kept looking at the road."
            n2 "Which was its own kind of answer, and she probably knew that too."

        "She asks something else entirely.":
            sh2 "Is the mountain temple far from here?"
            n2 "A pause."
            n2 "It was not the response the moment had been asking for."
            n2 "Makoto understood it anyway."
            mk2 "Four days in good conditions."
            sh2 "Mm."
            n2 "Shina kept looking at the road."

        "She says what isn't yes.":
            $ shina_stay_points += 1
            sh2 "I don't actually have anywhere else to be."
            n2 "She said it at the road, not at Makoto."
            n2 "Like it was information. Like it didn't carry anything behind it."
            n2 "Like she hadn't been arriving at it all day."
            show nvl_makoto flustered_hidden at nvl_stage_right onlayer nvl_chars with dissolve
            n2 "Makoto said nothing."
            n2 "She did not press."

    $ menu_owner = None

    nvl clear

    $ duck(level=0.1, delay=0.4)
    n2 "They stayed like that for a while."
    n2 "Makoto at the base of the wall. Shina above her, feet over the edge, naginata across her knees."
    n2 "The maple dropped a leaf. It made the only sound."
    $ unduck(level=0.2, delay=2.5)

    show nvl_makoto neutral at nvl_stage_right onlayer nvl_chars with dissolve
    mk2 "Get some sleep."
    mk2 "The deadline is morning, and you look like you haven't slept since noon."
    show nvl_shina smug at nvl_stage_left onlayer nvl_chars with dissolve
    sh2 "I'm very well rested."
    show nvl_makoto amused at nvl_stage_right onlayer nvl_chars with dissolve
    mk2 "You are a very open scroll, Shina."

    n2 "She turned and went back through the gate."

    hide nvl_makoto amused onlayer nvl_chars with dissolve

    $ duck(level=0.08, delay=0.3)
    n2 "The gate closed."
    n2 "Shina did not move."
    n2 "She watched the road below where the lantern light ran out."
    n2 "The maple. The south post. The latch that no longer creaked."
    $ unduck(level=0.2, delay=3.0)

    pause 1.5

    $ duck(level=0.05, delay=0.4)
    sh2 "...Evil Priestess."
    $ unduck(level=0.1, delay=3.0)

    n2 "She said it at the gate."
    n2 "No one heard it."
    n2 "That was fine."

    hide nvl_shina smug onlayer nvl_chars with dissolve

    nvl clear
    hide screen nvl_frame with Dissolve(0.5)
    stop music fadeout 2.5
    stop ambience fadeout 2.5
    pause 2.0

    if shina_stay_points >= 2:
        jump ch4_coda_morning
    else:
        scene bg black with slow_dissolve
        pause 2.0
        jump credits


## Coda — Part 1: The Morning
label ch4_coda_morning:
    scene bg black with slow_dissolve
    play music bgm_mountain_soft fadein 2.5 volume 0.2
    pause 1.5
    show screen nvl_frame with Dissolve(0.8)
    pause 0.4
    nvl clear

    n2 "She found Sato before the morning bell."
    n2 "The paperwork did not take long."
    n2 "The oath would follow later, at the home shrine, in front of proper witnesses."
    n2 "For now there was only a handshake and a form and Sato's expression, which managed to be entirely satisfied and entirely unsurprised in equal measure."

    nvl clear

    $ duck(level=0.1, delay=0.3)
    n2 "Shina walked back through the inner gate."
    n2 "The latch was quiet."
    $ unduck(level=0.2, delay=2.0)

    nvl clear
    hide screen nvl_frame with Dissolve(0.5)
    stop music fadeout 1.5
    pause 1.5

    jump ch4_coda_departure

## Coda — Part 2: The Departure

label ch4_coda_departure:
    scene bg temple_dusk with slow_dissolve
    play ambience morning_birds fadein 2.0 volume 0.6
    play music bgm_shrine_morning fadein 2.0 volume 0.25
    pause 1.5
    show screen nvl_frame with Dissolve(0.8)
    pause 0.4
    nvl clear

    n2 "The procession was not large."
    n2 "The cart. Two attendants. Sato, directing the loading with the focused competence of someone who had done this many times and intended to keep doing it correctly."
    n2 "Makoto in her travel robes, standing near the outer gate."

    nvl clear

    n2 "Shina was already there."
    n2 "Pack shouldered. Naginata in hand."
    n2 "She had not announced herself. She had not waited to be called."
    n2 "She was simply there, the way she had been simply there every morning of the past month — as if departure and arrival were the same kind of thing, and both required just showing up."

    show nvl_shina neutral at nvl_stage_left onlayer nvl_chars with dissolve
    show nvl_makoto neutral at nvl_stage_right onlayer nvl_chars with dissolve
    pause 0.5

    $ duck(level=0.1, delay=0.3)
    n2 "Shina considered the cart for a moment."
    $ unduck(level=0.2, delay=1.5)

    sh2 "The Tanaka kitchen had a specific technique for the rice."
    sh2 "Tell your cook. The portion on the miso, too. There's a right amount."

    mk2 "I will pass that along."
    sh2 "I'm serious. It matters."

    nvl clear

    n2 "Makoto looked at her."
    n2 "Then down."
    n2 "Then back up."

    show nvl_makoto amused at nvl_stage_right onlayer nvl_chars with dissolve

    $ duck(level=0.1, delay=0.3)
    n2 "Makoto's mouth moved."
    n2 "She did not stop it."
    $ unduck(level=0.2, delay=1.5)

    n2 "It was the smile that usually lived in private moments. The one that did not require containing."
    n2 "The first time it had been visible to anyone who happened to be looking."

    show nvl_shina neutral at nvl_stage_left onlayer nvl_chars with dissolve
    n2 "Shina followed her gaze down to the sandal strap."
    n2 "Then back up."

    sh2 "It catches opponents off guard."
    pause 0.5
    sh2 "Also helps me run faster."

    n2 "She said it the way she said things she had decided were true."
    n2 "No elaboration. No apology. Just the two facts, presented, available for inspection."

    nvl clear

    n2 "Makoto laughed."
    n2 "Not the diplomatic version. Not the contained, careful kind that asked permission of the room before it arrived."
    n2 "The hand near her mouth lowered."
    n2 "She did not bother raising it again."
    n2 "It was a different sound. Lighter. Without the role in it."
    n2 "The attendants glanced at each other."

    nvl clear

    show nvl_shina smug at nvl_stage_left onlayer nvl_chars with dissolve
    n2 "Shina looked at her."
    n2 "Then away."
    n2 "Doing something deliberate with her expression."
    n2 "The sandal remained untied."

    hide nvl_shina smug onlayer nvl_chars with dissolve
    hide nvl_makoto amused onlayer nvl_chars with dissolve

    nvl clear

    $ duck(level=0.12, delay=0.4)
    n2 "Sato, three paces away, had been counting the supply bundles."
    n2 "She heard the laugh."
    n2 "She turned."
    $ unduck(level=0.25, delay=2.0)

    show nvl_shina neutral at nvl_stage_center onlayer nvl_chars with dissolve

    n2 "She saw Shina."
    n2 "The left sandal strap, undone."
    n2 "The naginata at an angle that would eventually require a conversation."

    nvl clear

    n2 "She looked at this for a moment."
    n2 "Then she looked at Makoto."
    n2 "My lady was still laughing."

    $ duck(level=0.1, delay=0.3)
    n2 "Sato turned back to the cart."
    n2 "She began composing herself."
    n2 "She suspected this would require practice."
    $ unduck(level=0.2, delay=3.5)

    hide nvl_shina neutral onlayer nvl_chars with dissolve
    nvl clear
    hide screen nvl_frame with Dissolve(0.5)
    stop music fadeout 3.0
    stop ambience fadeout 3.0
    pause 3.0
    scene bg black with slow_dissolve
    pause 2.0

    jump credits
    return

